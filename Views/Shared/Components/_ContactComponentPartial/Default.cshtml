@model PortfolioSite.ViewModels.ContactViewModel
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> L

<aside aria-label="Contact" class="drawer-right-panel fixed top-0 right-0 bottom-0 z-50 w-full sm:w-[500px] lg:w-[40vw] max-w-2xl bg-[#111113] text-canvas p-8 sm:p-14 overflow-y-auto shadow-2xl flex flex-col justify-between" id="contact-drawer">
    <div>
        <div class="flex items-center justify-between pb-8 border-b border-neutral-800">
            <span class="font-mono text-xs uppercase tracking-widest text-amber-400 font-semibold">@Model.HeaderLabel</span>
            <button aria-label="Close" class="w-10 h-10 rounded-full border border-neutral-700 flex items-center justify-center hover:bg-canvas hover:text-ink transition-colors cursor-pointer" id="close-contact-btn" type="button">
                ✕
            </button>
        </div>

        <div class="mt-10">
            <h3 class="font-serif-editorial text-3xl sm:text-4xl text-white font-normal">
                @Model.Title <span class="italic font-light text-amber-300">@Model.TitleAccent</span>
            </h3>
            <p class="mt-3 text-sm sm:text-base text-neutral-400 font-light">@Model.Description</p>

            <form class="mt-8 space-y-6" id="contact-form" method="post" asp-controller="Contact" asp-action="SendMessage"
                  data-msg-processing="@L["Form_Processing"]"
                  data-msg-security="@L["Form_SecurityError"]"
                  data-msg-connection="@L["Form_ConnectionError"]">

                @* Honeypot: insanlar görmez, botlar doldurur *@
                <div aria-hidden="true" style="position:absolute; left:-9999px; top:auto; width:1px; height:1px; overflow:hidden;">
                    <label for="Website">Website</label>
                    <input autocomplete="off" id="Website" name="Website" tabindex="-1" type="text" />
                </div>

                <div>
                    <label class="block font-mono text-xs uppercase tracking-wider text-neutral-400 mb-2" for="FullName">@L["Contact_Name"]</label>
                    <input class="w-full bg-neutral-900/90 border border-neutral-800 rounded-xl px-4 py-3 text-canvas text-sm focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400 placeholder-neutral-600 transition-all" id="FullName" name="FullName" required type="text" />
                </div>
                <div>
                    <label class="block font-mono text-xs uppercase tracking-wider text-neutral-400 mb-2" for="EmailAddress">@L["Contact_Email"]</label>
                    <input class="w-full bg-neutral-900/90 border border-neutral-800 rounded-xl px-4 py-3 text-canvas text-sm focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400 placeholder-neutral-600 transition-all" id="EmailAddress" name="EmailAddress" required type="email" />
                </div>
                <div>
                    <label class="block font-mono text-xs uppercase tracking-wider text-neutral-400 mb-2" for="SubjectTopic">@L["Contact_Topic"]</label>
                    <select class="w-full bg-neutral-900 border border-neutral-800 rounded-xl px-4 py-3 text-canvas text-sm focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400 transition-all" id="SubjectTopic" name="SubjectTopic">
                        @foreach (var topic in Model.Topics)
                        {
                            <option value="@topic">@topic</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="block font-mono text-xs uppercase tracking-wider text-neutral-400 mb-2" for="MessageBody">@L["Contact_Message"]</label>
                    <textarea class="w-full bg-neutral-900/90 border border-neutral-800 rounded-xl px-4 py-3 text-canvas text-sm focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400 placeholder-neutral-600 transition-all resize-none" id="MessageBody" name="MessageBody" required rows="4"></textarea>
                </div>
                <div class="hidden p-3.5 rounded-xl bg-amber-400/10 border border-amber-400/30 text-amber-300 text-xs font-mono" id="form-feedback">
                    @L["Contact_Text"]
                </div>
                <button class="w-full py-3.5 px-6 rounded-full bg-amber-400 text-neutral-950 font-medium text-sm hover:bg-amber-300 hover:shadow-lg hover:shadow-amber-400/20 transition-all duration-200 flex items-center justify-center space-x-2 cursor-pointer" id="submit-btn" type="submit">
                    <span>@L["Contact_Send"]</span>
                    <span class="text-base">→</span>
                </button>
            </form>
        </div>
    </div>

    <div class="mt-10 pt-6 border-t border-neutral-900 flex justify-between items-center text-xs text-neutral-500 font-mono">
        <span>@Model.ResponseNote</span>
        @if (!string.IsNullOrWhiteSpace(Model.Email))
        {
            <a class="text-neutral-400 hover:text-white transition-colors" href="mailto:@Model.Email">@Model.Email</a>
        }
    </div>
</aside>