@model PortfolioSite.ViewModels.HeroViewModel

<section class="pt-16 pb-20 md:pt-28 md:pb-28 px-6 md:px-14" id="hero">
    <div class="max-w-7xl mx-auto">
        <div class="max-w-5xl">
            <h1 class="font-serif-editorial text-4xl sm:text-6xl md:text-7xl lg:text-[5.2rem] leading-[1.12] sm:leading-[1.15] tracking-tight font-normal text-ink">
                @Html.Raw(Model.HeadlineHtml)
            </h1>

            <div class="mt-12 md:mt-16 max-w-3xl">
                <p class="text-lg md:text-xl text-neutral-700 leading-relaxed font-light">@Model.Subtitle</p>
            </div>

            <div class="mt-14 sm:mt-20">
                <a class="inline-flex items-center px-6 py-2.5 rounded-full border border-ink/80 text-ink text-sm sm:text-base font-normal hover:bg-ink hover:text-canvas transition-colors duration-200" href="#projects">@Model.ButtonText</a>
            </div>
        </div>
    </div>
</section>