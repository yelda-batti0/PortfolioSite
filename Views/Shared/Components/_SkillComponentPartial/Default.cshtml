@model PortfolioSite.ViewModels.SkillsViewModel
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> L

<section class="py-20 md:py-28 px-6 md:px-14 bg-canvas border-t border-neutral-200" id="skills">
    <div class="max-w-7xl mx-auto">

        <div class="flex items-center justify-between pb-12">
            <div>
                <span class="font-mono text-xs uppercase tracking-widest text-muted block mb-2">@Model.Label</span>
                <div class="flex items-center space-x-3">
                    <span class="text-2xl text-ink">➴</span>
                    <h2 class="font-serif-editorial text-3xl sm:text-5xl font-normal text-ink">
                        @Html.Raw(Model.TitleHtml)
                    </h2>
                </div>
            </div>
            <span class="hidden sm:inline-block font-mono text-xs text-muted">@Model.SideNote</span>
        </div>

        <div class="divide-y divide-neutral-400">
            @foreach (var item in Model.Items)
            {
                <div class="py-7 md:py-9 grid grid-cols-1 md:grid-cols-12 gap-6 items-baseline transition-colors hover:bg-neutral-100/50 px-2 rounded-lg">
                    <div class="md:col-span-4 flex items-center space-x-3">
                        @if (!string.IsNullOrWhiteSpace(item.IconKey))
                        {
                            <div class="flex items-center text-neutral-800 opacity-90">
                                @switch (item.IconKey)
                                {
                                    case "backend":
                                        <svg aria-hidden="true" class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" viewBox="0 0 24 24">
                                            <rect height="16" rx="2" width="20" x="2" y="4"></rect>
                                            <path d="M7 10l3 3-3 3M13 16h4"></path>
                                        </svg>
                                        break;
                                    case "database":
                                        <svg aria-hidden="true" class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" viewBox="0 0 24 24">
                                            <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
                                            <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
                                            <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
                                        </svg>
                                        break;
                                    case "network":
                                        <svg aria-hidden="true" class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" viewBox="0 0 24 24">
                                            <circle cx="18" cy="5" r="3"></circle>
                                            <circle cx="6" cy="12" r="3"></circle>
                                            <circle cx="18" cy="19" r="3"></circle>
                                            <line x1="8.59" x2="15.42" y1="13.51" y2="17.49"></line>
                                            <line x1="15.41" x2="8.59" y1="6.51" y2="10.49"></line>
                                        </svg>
                                        break;
                                    case "code":
                                        <svg aria-hidden="true" class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" viewBox="0 0 24 24">
                                            <polyline points="16 18 22 12 16 6"></polyline>
                                            <polyline points="8 6 2 12 8 18"></polyline>
                                        </svg>
                                        break;
                                }
                            </div>
                        }
                        <h3 class="text-base sm:text-lg font-normal text-neutral-800">@item.Name</h3>
                    </div>

                    <div class="md:col-span-5">
                        <p class="text-base sm:text-lg font-medium text-ink">@item.MainLine</p>
                        <p class="text-xs sm:text-sm text-neutral-500 font-mono mt-1">@item.Detail</p>
                    </div>

                    <div class="md:col-span-3 md:text-right">
                        <span class="font-mono text-xs sm:text-sm text-neutral-600">@item.Badge</span>
                    </div>
                </div>
            }
        </div>

        <div class="mt-14 flex justify-center">
            <a class="inline-flex items-center space-x-2 px-5 py-2 rounded-full border border-neutral-300 text-xs font-mono text-neutral-600 hover:text-ink hover:border-ink transition-colors" href="#hero">
                <span>↑</span>
                <span>@L["Common_BackToTop"]</span>
            </a>
        </div>
    </div>
</section>