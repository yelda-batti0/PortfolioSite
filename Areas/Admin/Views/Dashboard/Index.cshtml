@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Genel Bakış";
}

<h1 class="font-serif-editorial text-4xl">Genel <span class="italic font-light">bakış</span></h1>
<p class="mt-2 text-sm text-neutral-600">Sitende neler olduğuna hızlıca göz at.</p>

<div class="mt-10 grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-6">
    <a asp-area="Admin" asp-controller="Project" asp-action="Index" class="block bg-[#F4F1EC] border border-neutral-300/80 rounded-3xl p-6 hover:border-neutral-400 transition-colors">
        <p class="font-mono text-xs uppercase tracking-wider text-neutral-500">Projeler</p>
        <p class="mt-3 font-serif-editorial text-5xl">@ViewBag.ProjectCount</p>
    </a>
    <a asp-area="Admin" asp-controller="Skill" asp-action="Index" class="block bg-[#F4F1EC] border border-neutral-300/80 rounded-3xl p-6 hover:border-neutral-400 transition-colors">
        <p class="font-mono text-xs uppercase tracking-wider text-neutral-500">Yetenekler</p>
        <p class="mt-3 font-serif-editorial text-5xl">@ViewBag.SkillCount</p>
    </a>
    <a asp-area="Admin" asp-controller="Message" asp-action="Index" class="block bg-[#F4F1EC] border border-neutral-300/80 rounded-3xl p-6 hover:border-neutral-400 transition-colors">
        <p class="font-mono text-xs uppercase tracking-wider text-neutral-500">Toplam mesaj</p>
        <p class="mt-3 font-serif-editorial text-5xl">@ViewBag.MessageCount</p>
    </a>
    <a asp-area="Admin" asp-controller="Message" asp-action="Index" class="block bg-ink text-canvas rounded-3xl p-6 hover:bg-neutral-800 transition-colors">
        <p class="font-mono text-xs uppercase tracking-wider text-canvas/70">Okunmamış</p>
        <p class="mt-3 font-serif-editorial text-5xl">@ViewBag.UnreadCount</p>
    </a>
</div>